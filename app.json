{
  "expo": {
    "name": "ShelfFlow",
    "slug": "stokify",
    "owner": "usaidakhunji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shelfflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
  "image": "./assets/images/splash.png",
  "resizeMode": "contain",
  "backgroundColor": "#061A3A"
},
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.shelfflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#f0f2f5"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "ShelfFlow needs camera access to scan product barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ad616675-4eb8-4276-8617-0e31c36f17e7"
      }
    }
  }
}
